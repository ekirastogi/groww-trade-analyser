# Backend environment — copy to .env and fill in

# Firebase project (backend writes results + listens for approvals)
FIREBASE_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Market data: stooq+yahoo (default) | yahoo | stooq | nse | groww
MARKET_DATA_PROVIDER=stooq+yahoo

# Default symbols if universe collection is empty
WATCH_SYMBOLS=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK

# Ingestion interval for hot-set quotes (default 5m)
INGEST_INTERVAL=5m

# HTTP API bind address (default :8080). Set to off to disable.
HTTP_ADDR=:8080

# Volume shocker detection (EOD)
VOLUME_SHOCKER_TOP_N=20
VOLUME_SHOCKER_HOLD_DAYS=5

# Local SQLite path (default ~/.groww-trader/market.db)
# DB_PATH=/Users/you/.groww-trader/market.db

# Future Groww trading API
# GROWW_API_TOKEN=

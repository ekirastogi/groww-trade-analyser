# Backend environment — copy to .env and fill in

# Firebase project (backend writes results + listens for approvals)
FIREBASE_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Market data — Groww Trade API only (requires active API subscription)
MARKET_DATA_PROVIDER=groww

# Option A: daily access token from Groww → Settings → Trading APIs → Generate API keys → Access Token
GROWW_ACCESS_TOKEN=

# Option B: auto-mint access token each day (requires daily approval on Groww Cloud API Keys page)
# GROWW_API_KEY=
# GROWW_API_SECRET=
# OR use TOTP instead of secret:
# GROWW_TOTP=

# Set to true to place real orders on approved recommendations (default: dry-run)
# GROWW_ENABLE_TRADING=false

# Default symbols if universe collection is empty
WATCH_SYMBOLS=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK

# Ingestion interval for hot-set quotes (default 15m)
INGEST_INTERVAL=15m

# Max P&L universe symbols to hot-ingest per tick (not the full CSV seed book)
HOT_SYMBOLS_MAX=30

# Worker heartbeat Firestore write interval
HEARTBEAT_INTERVAL=5m

# Cache duration for Firestore universe collection reads
UNIVERSE_CACHE_MINUTES=30

# Cache duration for volumeShockers/active reads
SHOCKERS_CACHE_MINUTES=5

# Min interval between marketCatalog/summary writes during hot ingest
CATALOG_FLUSH_MINUTES=5

# Poll intervals (replace snapshot listeners on the worker)
WORKER_JOB_POLL_INTERVAL=30s
APPROVAL_POLL_INTERVAL=30s

# HTTP API bind address (default :8080). Set to off to disable.
HTTP_ADDR=:8080

# Volume shocker detection (EOD)
VOLUME_SHOCKER_TOP_N=20
VOLUME_SHOCKER_HOLD_DAYS=5

# Verbose logging (per-symbol progress). Set to false to reduce noise.
LOG_VERBOSE=true

# Local SQLite path (default ~/.groww-trader/market.db)
# DB_PATH=/Users/you/.groww-trader/market.db

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if isAuth() && request.auth.uid == uid;
    }

    // Market snapshots + chart data — written by local backend service account, read by UI
    match /stocks/{symbol} {
      allow read: if isAuth();
      allow write: if false;
    }

    match /watchlists/{id} {
      allow read, write: if isAuth();
    }

    match /recommendations/{id} {
      allow read: if isAuth();
      // UI can approve/reject; backend service account writes initial + execution updates
      allow create: if false;
      allow update: if isAuth()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['approvalStatus', 'status', 'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy']);
      allow delete: if false;
    }

    match /tradeOutcomes/{id} {
      allow read: if isAuth();
      allow write: if false;
    }
  }
}
